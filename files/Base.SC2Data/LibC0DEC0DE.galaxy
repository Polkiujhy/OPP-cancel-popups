void OPP_BuildSignal (unit building, bool progress) {
    int owner;
    int tag;
    int i;
    int slot;
    string objectType;
    string icon;
    if (building == null) { return; }
    owner = UnitGetOwner(building);
    tag = UnitGetTag(building);
    objectType = UnitGetType(building);
    if (tag <= 0 || objectType == "" || owner < 1 || owner >= c_playerAny) { return; }
    slot = -1;
    for (i = 0; i < 128; i += 1) {
        if (OPP_BuildTags[i] == tag) { slot = i; }
    }
    if (slot < 0) {
        slot = OPP_BuildNext;
        OPP_BuildNext = (OPP_BuildNext + 1) % 128;
        OPP_BuildTags[slot] = tag;
        OPP_BuildProgress[slot] = false;
        OPP_BuildOrder[slot] = false;
        OPP_BuildNotified[slot] = false;
    }
    if (progress) { OPP_BuildProgress[slot] = true; }
    else { OPP_BuildOrder[slot] = true; }
    if (!OPP_BuildProgress[slot] || !OPP_BuildOrder[slot] || OPP_BuildNotified[slot]) { return; }
    OPP_BuildNotified[slot] = true;
    icon = CatalogFieldValueGet(c_gameCatalogActor, objectType, "UnitIcon", owner);
    DataTableSetInt(true, "OPPCancelPopups/BuildingCancels", DataTableGetInt(true, "OPPCancelPopups/BuildingCancels") + 1);
    OPP_UI_PushTyped(owner, UnitTypeGetName(objectType), icon, OPP_KIND_BUILDING, objectType);
}

