    <Frame type="Frame" name="GameUI/UIContainer/FullscreenUpperContainer/TimerNotificationPanel/ToggledContent" file="GameUI">
        <Frame type="Frame" name="OPPCancelStack">
            <!-- Fixed space below production; worker visibility must not move our stack. -->
            <Anchor side="Left" relative="$parent/$parent/$parent" pos="Min" offset="0" />
