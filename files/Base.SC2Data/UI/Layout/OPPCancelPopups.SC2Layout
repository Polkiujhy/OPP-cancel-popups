                        <Anchor side="Bottom" relative="$parent" pos="Max" offset="-2" />
                        <Height val="20" />
                        <Style val="OPPCancelOwner" />
                        <IgnoreParentColor val="true" />
                        <RenderPriority val="501" />
                        <AcceptsMouse val="false" />
                    </Frame>
                    <Unclipped val="true" />
                    <Frame type="Image" name="TimerIcon">
