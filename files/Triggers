                void OPP_WarpForget (int generation) {
                    string key;
                    string edge;
                    int source;
                    int next;
                    key = OPP_WarpKey(generation);
                    source = DataTableGetInt(true, key + "Providers");
                    while (source &gt; 0) {
                        edge = OPP_WarpEdge(generation, source);
                        next = DataTableGetInt(true, edge + "Next");
                        DataTableValueRemove(true, edge + "Next");
                        DataTableValueRemove(true, edge + "Known");
                        DataTableValueRemove(true, edge + "Current");
                        DataTableValueRemove(true, edge + "Lost");
                        DataTableValueRemove(true, edge + "LostTime");
                        DataTableValueRemove(true, edge + "SourceTag");
                        DataTableValueRemove(true, edge + "Death");
                        DataTableValueRemove(true, edge + "DeathTime");
                        DataTableValueRemove(true, edge + "CloseOrder");
                        DataTableValueRemove(true, edge + "CloseOrderTime");
                        DataTableValueRemove(true, edge + "CloseExecute");
                        DataTableValueRemove(true, edge + "CloseExecuteTime");
                        source = next;
                    }
                    DataTableValueRemove(true, OPP_WarpIndex(DataTableGetInt(true, key + "Tag")));
                    DataTableValueRemove(true, key + "Unit");
                    DataTableValueRemove(true, key + "Producer");
                    DataTableValueRemove(true, key + "Tag");
                    DataTableValueRemove(true, key + "Owner");
                    DataTableValueRemove(true, key + "Type");
                    DataTableValueRemove(true, key + "Ability");
                    DataTableValueRemove(true, key + "Point");
                    DataTableValueRemove(true, key + "Start");
                    DataTableValueRemove(true, key + "Next");
                    DataTableValueRemove(true, key + "Providers");
                    DataTableValueRemove(true, key + "Cancelled");
                    DataTableValueRemove(true, key + "End");
                    DataTableValueRemove(true, key + "Order");
                    DataTableValueRemove(true, key + "OrderTime");
                    DataTableValueRemove(true, key + "Sent");
                    DataTableValueRemove(true, key + "Decided");
                    DataTableValueRemove(true, key + "Retiring");
                    DataTableValueRemove(true, key + "RetireTime");
                    OPP_WarpRecords -= 1;
                }
                
                bool OPP_PrismCollect (bool testConds, bool runActions) {
                    int generation;
                    int previous;
                    int next;
                    string key;
                    unit subject;
                    bool terminal;
                    bool remove;
                    if (!runActions) { return true; }
                    generation = OPP_WarpHead;
                    previous = 0;
                    while (generation &gt; 0) {
                        key = OPP_WarpKey(generation);
                        next = DataTableGetInt(true, key + "Next");
                        subject = DataTableGetUnit(true, key + "Unit");
                        terminal = subject == null || !UnitIsValid(subject) || !UnitIsAlive(subject) || !UnitTestState(subject, c_unitStateUnderConstruction);
                        if (DataTableGetBool(true, key + "Cancelled") &amp;&amp; DataTableGetFixed(true, key + "End") + 0.0625 &lt; GameGetMissionTime()) { OPP_WarpPublish(generation); }
                        if (terminal &amp;&amp; !DataTableGetBool(true, key + "Retiring")) {
                            DataTableSetBool(true, key + "Retiring", true);
                            DataTableSetFixed(true, key + "RetireTime", GameGetMissionTime());
                        }
                        remove = terminal &amp;&amp; DataTableGetBool(true, key + "Retiring") &amp;&amp; DataTableGetFixed(true, key + "RetireTime") + 0.5 &lt; GameGetMissionTime();
                        if (remove) {
                            if (previous == 0) { OPP_WarpHead = next; }
                            else { DataTableSetInt(true, OPP_WarpKey(previous) + "Next", next); }
                            OPP_WarpForget(generation);
                        }
                        else { previous = generation; }
                        generation = next;
                    }
                    // Source metadata outlives the correlation and is pruned only afterwards.
                    generation = OPP_PowerHead;
                    previous = 0;
                    while (generation &gt; 0) {
                        key = OPP_PowerKey(generation);
                        next = DataTableGetInt(true, key + "Next");
                        subject = DataTableGetUnit(true, key + "Unit");
                        terminal = subject == null || !UnitIsValid(subject) || !UnitIsAlive(subject);
                        if (!terminal &amp;&amp; UnitGetType(subject) != DataTableGetString(true, key + "Type")) { terminal = !OPP_PowerCapable(subject); }
                        remove = terminal &amp;&amp; DataTableGetFixed(true, key + "Touched") + 0.25 &lt; GameGetMissionTime();
                        if (remove) {
                            OPP_WarpRefreshSource(generation);
                            if (previous == 0) { OPP_PowerHead = next; }
                            else { DataTableSetInt(true, OPP_PowerKey(previous) + "Next", next); }
                            DataTableValueRemove(true, OPP_PowerIndex(DataTableGetInt(true, key + "Tag")));
                            DataTableValueRemove(true, key + "Unit");
                            DataTableValueRemove(true, key + "Tag");
                            DataTableValueRemove(true, key + "Type");
                            DataTableValueRemove(true, key + "Next");
                            DataTableValueRemove(true, key + "Touched");
                            DataTableValueRemove(true, key + "Order");
                            DataTableValueRemove(true, key + "OrderTime");
                            DataTableValueRemove(true, key + "Execute");
                            DataTableValueRemove(true, key + "ExecuteTime");
                            DataTableValueRemove(true, key + "Death");
                            DataTableValueRemove(true, key + "DeathTime");
                            OPP_PowerRecords -= 1;
                        }
                        else { previous = generation; }
                        generation = next;
                    }
                    return true;
                }
                
                void OPP_Prism_Init () {
                    trigger event;
