        <Element Type="CustomScript" Id="00000001">
            <Name>OPP Cancel Popups - generated canonical source</Name>
            <ScriptCode>
                // Rows use the completed-upgrade proportions in our separate left-column stack.
                // Queue ownership stays separate from GameHeart research-facility slots.
                // Observer routing follows the verified GameHeart DefaultObservedPlayerId contract.
                const int OPP_UI_ROWS = 3;
                const int OPP_UI_CAPACITY = 128;
                bool OPP_UI_Ready = false;
                playergroup OPP_UI_Viewers;
                int OPP_UI_ViewerId;
                int[3] OPP_UI_Panel;
                int[3] OPP_UI_Background;
                int[3] OPP_UI_Icon;
                int[3] OPP_UI_Owner;
                int[3] OPP_UI_Name;
                int[3] OPP_UI_Status;
                timer[3] OPP_UI_Timer;
                bool[3] OPP_UI_Busy;
                int[128] OPP_UI_QueueOwner;
                text[128] OPP_UI_QueueName;
                string[128] OPP_UI_QueueIcon;
                int OPP_UI_Head = 0;
                int OPP_UI_Count = 0;
                int[17][3] OPP_UI_Overflow;
                const int OPP_KIND_BUILDING = 0;
                const int OPP_KIND_RESEARCH = 1;
                const int OPP_KIND_UNIT = 2;
                int[3] OPP_UI_RowOwner;
                int[3] OPP_UI_RowKind;
                string[3] OPP_UI_RowKey;
                int[3] OPP_UI_RowCount;
                string[128] OPP_UI_QueueKey;
                int[128] OPP_UI_QueueKind;
                int[128] OPP_UI_QueueCopies;
                
                text OPP_UI_CancelStatus (int count) {
                    if (count &gt; 1) { return StringExternal("OPP/Cancelled") + StringToText(" ×") + IntToText(count); }
                    return StringExternal("OPP/Cancelled");
                }
                
                void OPP_UI_Show (int row, int owner, text objectName, string icon, int kind, string objectKey, int count) {
                    libNtve_gf_SetDialogItemColor(OPP_UI_Background[row], libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(owner, false)), OPP_UI_Viewers);
                    DialogControlSetVisible(OPP_UI_Background[row], OPP_UI_Viewers, true);
                    libNtve_gf_SetDialogItemText(OPP_UI_Owner[row], PlayerName(owner), OPP_UI_Viewers);
                    libNtve_gf_SetDialogItemColor(OPP_UI_Owner[row], libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(owner, false)), OPP_UI_Viewers);
                    libNtve_gf_SetDialogItemText(OPP_UI_Name[row], objectName, OPP_UI_Viewers);
                    libNtve_gf_SetDialogItemImage(OPP_UI_Icon[row], icon, OPP_UI_Viewers);
                    libNtve_gf_SetDialogItemText(OPP_UI_Status[row], OPP_UI_CancelStatus(count), OPP_UI_Viewers);
                    DialogControlSetVisible(OPP_UI_Icon[row], OPP_UI_Viewers, true);
                    // The player-colored icon square identifies the owner; keep its label for probes only.
                    DialogControlSetVisible(OPP_UI_Owner[row], OPP_UI_Viewers, false);
                    DialogControlSetVisible(OPP_UI_Name[row], OPP_UI_Viewers, true);
                    DialogControlSetVisible(OPP_UI_Status[row], OPP_UI_Viewers, true);
                    DialogControlSetVisible(OPP_UI_Panel[row], OPP_UI_Viewers, true);
                    OPP_UI_RowOwner[row] = owner;
                    OPP_UI_RowKind[row] = kind;
                    OPP_UI_RowKey[row] = objectKey;
                    OPP_UI_RowCount[row] = count;
                    OPP_UI_Busy[row] = true;
                    TimerStart(OPP_UI_Timer[row], 5.0, false, c_timeGame);
                    DataTableSetInt(true, "OPPCancelPopups/Displayed", DataTableGetInt(true, "OPPCancelPopups/Displayed") + 1);
                }
                
                void OPP_UI_Drain () {
                    int row;
                    int owner;
                    int kind;
                    int count;
                    text summary;
                    for (row = 0; row &lt; OPP_UI_ROWS; row += 1) {
                        if (!OPP_UI_Busy[row]) {
                            if (OPP_UI_Count &gt; 0) {
                                OPP_UI_Show(row, OPP_UI_QueueOwner[OPP_UI_Head], OPP_UI_QueueName[OPP_UI_Head], OPP_UI_QueueIcon[OPP_UI_Head], OPP_UI_QueueKind[OPP_UI_Head], OPP_UI_QueueKey[OPP_UI_Head], OPP_UI_QueueCopies[OPP_UI_Head]);
                                OPP_UI_QueueName[OPP_UI_Head] = null;
                                OPP_UI_QueueIcon[OPP_UI_Head] = "";
                                OPP_UI_QueueKey[OPP_UI_Head] = "";
                                OPP_UI_QueueCopies[OPP_UI_Head] = 0;
                                OPP_UI_Head = (OPP_UI_Head + 1) % OPP_UI_CAPACITY;
                                OPP_UI_Count -= 1;
                            }
                            else {
                                for (owner = 1; owner &lt; c_playerAny; owner += 1) {
                                    for (kind = 0; kind &lt; 3; kind += 1) {
                                        count = OPP_UI_Overflow[owner][kind];
                                        if (!OPP_UI_Busy[row] &amp;&amp; count &gt; 0) {
                                            summary = IntToText(count) + StringExternal("OPP/MoreBuildings");
                                            if (kind == 1) {
                                                summary = IntToText(count) + StringExternal("OPP/MoreUpgrades");
                                            }
                                            if (kind == OPP_KIND_UNIT) {
                                                summary = IntToText(count) + StringExternal("OPP/MoreUnits");
                                            }
                                            OPP_UI_Overflow[owner][kind] = 0;
                                            OPP_UI_Show(row, owner, summary, "Assets\\Textures\\btn-command-cancel.dds", kind, "", 1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                
                bool OPP_UI_MergeActive (int owner, int kind, string objectKey) {
                    int row;
                    if (objectKey == "") { return false; }
                    for (row = 0; row &lt; OPP_UI_ROWS; row += 1) {
                        if (OPP_UI_Busy[row] &amp;&amp; TimerGetRemaining(OPP_UI_Timer[row]) &gt; 0.0 &amp;&amp; OPP_UI_RowOwner[row] == owner &amp;&amp; OPP_UI_RowKind[row] == kind &amp;&amp; OPP_UI_RowKey[row] == objectKey) {
                            OPP_UI_RowCount[row] += 1;
                            libNtve_gf_SetDialogItemText(OPP_UI_Status[row], OPP_UI_CancelStatus(OPP_UI_RowCount[row]), OPP_UI_Viewers);
                            TimerStart(OPP_UI_Timer[row], 5.0, false, c_timeGame);
                            return true;
                        }
                    }
                    return false;
                }
                
                void OPP_UI_PushTyped (int owner, text objectName, string icon, int kind, string objectKey) {
                    int tail;
                    int offset;
                    int index;
                    if (!OPP_UI_Ready || owner &lt; 1 || owner &gt;= c_playerAny || kind &lt; 0 || kind &gt;= 3) { return; }
                    // A catalog ID, kind and owner identify a group for its entire pending lifetime.
                    if (OPP_UI_MergeActive(owner, kind, objectKey)) { return; }
                    OPP_UI_Drain();
                    // Drain may just have displayed the same group; preserve its count and refresh it.
                    if (OPP_UI_MergeActive(owner, kind, objectKey)) { return; }
                    if (objectKey != "") {
                        for (offset = 0; offset &lt; OPP_UI_Count; offset += 1) {
                            index = (OPP_UI_Head + offset) % OPP_UI_CAPACITY;
                            if (OPP_UI_QueueOwner[index] == owner &amp;&amp; OPP_UI_QueueKind[index] == kind &amp;&amp; OPP_UI_QueueKey[index] == objectKey) {
                                OPP_UI_QueueCopies[index] += 1;
                                return;
                            }
                        }
                    }
                    // Search existing groups before overflow: a duplicate consumes no new group slot.
                    if (OPP_UI_Count == OPP_UI_CAPACITY) {
                        OPP_UI_Overflow[owner][kind] += 1;
                        return;
                    }
                    tail = (OPP_UI_Head + OPP_UI_Count) % OPP_UI_CAPACITY;
                    OPP_UI_QueueOwner[tail] = owner;
                    OPP_UI_QueueName[tail] = objectName;
                    OPP_UI_QueueIcon[tail] = icon;
                    OPP_UI_QueueKind[tail] = kind;
                    OPP_UI_QueueKey[tail] = objectKey;
                    OPP_UI_QueueCopies[tail] = 1;
                    OPP_UI_Count += 1;
                    OPP_UI_Drain();
                }
                
                // Preserve the unkeyed fixture entry point; production events use typed catalog IDs.
                void OPP_UI_Push (int owner, text objectName, string icon, bool research) {
                    int kind;
                    kind = OPP_KIND_BUILDING;
                    if (research) { kind = OPP_KIND_RESEARCH; }
                    OPP_UI_PushTyped(owner, objectName, icon, kind, "");
                }
                
                bool OPP_UI_Expire (bool testConds, bool runActions) {
                    int row;
                    if (!runActions) { return true; }
                    for (row = 0; row &lt; OPP_UI_ROWS; row += 1) {
                        if (EventTimer() == OPP_UI_Timer[row] &amp;&amp; TimerGetRemaining(OPP_UI_Timer[row]) &lt;= 0.0) {
                            DialogControlSetVisible(OPP_UI_Panel[row], OPP_UI_Viewers, false);
                            OPP_UI_Busy[row] = false;
                        }
                    }
                    OPP_UI_Drain();
                    return true;
                }
                
                int OPP_UI_Hook (int kind, string path) {
                    int control;
                    control = DialogControlHookupStandard(kind, path);
                    if (control != c_invalidDialogControlId) {
                        DialogControlSetObservedType(control, c_triggerObservedTypeDefaultObservedPlayerId);
                    }
                    return control;
                }
                
                void OPP_UI_Init () {
                    int row;
                    string path;
                    trigger expiry;
                    OPP_UI_ViewerId = CatalogFieldValueGetAsInt(c_gameCatalogGameUI, "Dflt", "DefaultObservedPlayerId", c_playerAny);
                    DataTableSetInt(true, "OPPCancelPopups/ObserverId", OPP_UI_ViewerId);
                    if (OPP_UI_ViewerId &lt; 1 || OPP_UI_ViewerId &gt;= c_maxPlayers || PlayerGroupHasPlayer(PlayerGroupActive(), OPP_UI_ViewerId)) { return; }
                    OPP_UI_Viewers = PlayerGroupSingle(OPP_UI_ViewerId);
                    expiry = TriggerCreate("OPP_UI_Expire");
                    for (row = 0; row &lt; OPP_UI_ROWS; row += 1) {
                        path = "UIContainer/FullscreenUpperContainer/TimerNotificationPanel/ToggledContent/OPPCancelStack/OPPCancelRow" + IntToString(row);
                        OPP_UI_Panel[row] = OPP_UI_Hook(c_triggerControlTypePanel, path);
                        // Record an explicit initial visibility value. Replay seeks can reuse
                        // the loaded layout, so XML defaults alone leave stale rows on screen.
                        if (OPP_UI_Panel[row] != c_invalidDialogControlId) {
                            DialogControlSetVisible(OPP_UI_Panel[row], PlayerGroupAll(), false);
                        }
                        OPP_UI_Icon[row] = OPP_UI_Hook(c_triggerControlTypeImage, path + "/TimerWindow/TimerIcon");
                        OPP_UI_Background[row] = OPP_UI_Hook(c_triggerControlTypeImage, path + "/TimerWindow/ColorAccent");
                        OPP_UI_Owner[row] = OPP_UI_Hook(c_triggerControlTypeLabel, path + "/TimerWindow/Owner");
                        OPP_UI_Name[row] = OPP_UI_Hook(c_triggerControlTypeLabel, path + "/TimerWindow/TimerType");
                        OPP_UI_Status[row] = OPP_UI_Hook(c_triggerControlTypeLabel, path + "/TimerWindow/TimerStatus");
                        if (OPP_UI_Panel[row] == 0 || OPP_UI_Background[row] == 0 || OPP_UI_Icon[row] == 0 || OPP_UI_Owner[row] == 0 || OPP_UI_Name[row] == 0 || OPP_UI_Status[row] == 0) { return; }
                        // Read-only fixture probes query the actual control values/visibility.
                        DataTableSetInt(true, "OPPCancelPopups/Panel" + IntToString(row), OPP_UI_Panel[row]);
                        DataTableSetInt(true, "OPPCancelPopups/Name" + IntToString(row), OPP_UI_Name[row]);
                        DataTableSetInt(true, "OPPCancelPopups/Owner" + IntToString(row), OPP_UI_Owner[row]);
                        DataTableSetInt(true, "OPPCancelPopups/Status" + IntToString(row), OPP_UI_Status[row]);
                        OPP_UI_Timer[row] = TimerCreate();
                        TriggerAddEventTimer(expiry, OPP_UI_Timer[row]);
                    }
                    OPP_UI_Ready = true;
                    DataTableSetBool(true, "OPPCancelPopups/UIReady", true);
                }
                // A construction attempt is the created child's tag, never the parent's lifetime.
                // Store metadata before removal: dead addons lose their live owner/type, and the
                // native addon relationship getters are null during construction (runtime v65).
                // DataTable keys do not recycle an active/pending attempt after 128 other builds.
                string OPP_BuildKey (int tag) {
                    return "OPPCancelPopups/Build/" + IntToString(tag) + "/";
                }
                
                text OPP_BuildName (string objectType) {
                    if (objectType == "BarracksTechLab") { return StringExternal("OPP/BarracksTechLab"); }
                    if (objectType == "FactoryTechLab") { return StringExternal("OPP/FactoryTechLab"); }
                    if (objectType == "StarportTechLab") { return StringExternal("OPP/StarportTechLab"); }
                    if (objectType == "BarracksReactor") { return StringExternal("OPP/BarracksReactor"); }
                    if (objectType == "FactoryReactor") { return StringExternal("OPP/FactoryReactor"); }
                    if (objectType == "StarportReactor") { return StringExternal("OPP/StarportReactor"); }
                    return UnitTypeGetName(objectType);
                }
                
                void OPP_BuildRemember (unit child, unit parent, string ability) {
                    string key;
                    string objectType;
                    int tag;
                    int owner;
                    int parentTag;
                    if (child == null || !UnitIsAlive(child)) { return; }
                    objectType = UnitGetType(child);
                    if (!UnitTypeTestAttribute(objectType, c_unitAttributeStructure)) { return; }
                    tag = UnitGetTag(child);
                    owner = UnitGetOwner(child);
                    if (tag &lt;= 0 || owner &lt; 1 || owner &gt;= c_playerAny) { return; }
                    key = OPP_BuildKey(tag);
                    if (DataTableGetBool(true, key + "Closed")) { return; }
                    DataTableSetInt(true, key + "Owner", owner);
                    DataTableSetString(true, key + "Type", objectType);
                    // The creator response, not UnitAddOnChild/Parent, identifies this attempt.
                    if (parent != null &amp;&amp; AbilityClass(ability) == c_classIdCAbilBuild &amp;&amp; CatalogFieldValueGet(c_gameCatalogAbil, ability, "Type", owner) == "AddOn") {
                        parentTag = UnitGetTag(parent);
                        if (parentTag &lt;= 0) { return; }
                        DataTableSetInt(true, key + "Parent", parentTag);
                        DataTableSetString(true, key + "Ability", ability);
                        DataTableSetInt(true, OPP_BuildKey(parentTag) + "Child", tag);
                    }
                }
                
                void OPP_BuildPublish (int tag) {
                    string key;
                    string objectType;
                    string icon;
                    int owner;
                    key = OPP_BuildKey(tag);
                    if (tag &lt;= 0 || DataTableGetBool(true, key + "Closed") || !DataTableGetBool(true, key + "Progress") || !DataTableGetBool(true, key + "Order")) { return; }
                    if (DataTableGetFixed(true, key + "ProgressTime") != DataTableGetFixed(true, key + "OrderTime")) { return; }
                    objectType = DataTableGetString(true, key + "Type");
                    owner = DataTableGetInt(true, key + "Owner");
                    if (objectType == "" || owner &lt; 1 || owner &gt;= c_playerAny) { return; }
                    // Both routes meet here, before incrementing counters or enqueuing the UI.
                    DataTableSetBool(true, key + "Closed", true);
                    icon = CatalogFieldValueGet(c_gameCatalogActor, objectType, "UnitIcon", owner);
                    DataTableSetInt(true, "OPPCancelPopups/BuildingCancels", DataTableGetInt(true, "OPPCancelPopups/BuildingCancels") + 1);
                    OPP_UI_PushTyped(owner, OPP_BuildName(objectType), icon, OPP_KIND_BUILDING, objectType);
                }
                
                void OPP_BuildOrderSignal (int tag) {
                    string key;
                    if (tag &lt;= 0) { return; }
                    key = OPP_BuildKey(tag);
                    if (DataTableGetBool(true, key + "Closed")) { return; }
                    DataTableSetBool(true, key + "Order", true);
                    DataTableSetFixed(true, key + "OrderTime", GameGetMissionTime());
                    OPP_BuildPublish(tag);
                }
                
                bool OPP_BuildCreated (bool testConds, bool runActions) {
                    if (!runActions || !UnitTestState(EventUnitCreatedUnit(), c_unitStateUnderConstruction)) { return true; }
                    OPP_BuildRemember(EventUnitCreatedUnit(), EventUnit(), EventUnitCreatedAbil());
                    return true;
                }
                
                bool OPP_BuildStarted (bool testConds, bool runActions) {
                    // Ordinary buildings also have this progress path. Addon metadata comes
                    // from Created, including the actual creator ability and parent.
                    if (!runActions) { return true; }
                    OPP_BuildRemember(EventUnitProgressUnit(), null, "");
                    return true;
                }
                
                void OPP_BuildProgressSignal (unit parent, unit child, string objectType) {
                    string key;
                    string parentKey;
                    int tag;
                    int parentTag;
                    if (child == null) { return; }
                    tag = UnitGetTag(child);
                    if (tag &lt;= 0) { return; }
                    key = OPP_BuildKey(tag);
                    if (DataTableGetBool(true, key + "Closed")) { return; }
                    // Fallback only while the object still has valid metadata. Never substitute
                    // EventUnit's owner/type: EventUnit is the producer, not the cancelled child.
                    if (DataTableGetString(true, key + "Type") == "") { OPP_BuildRemember(child, null, ""); }
                    parentTag = DataTableGetInt(true, key + "Parent");
                    if (parentTag &gt; 0) {
                        if (parent == null || UnitGetTag(parent) != parentTag || objectType != DataTableGetString(true, key + "Type")) { return; }
                        parentKey = OPP_BuildKey(parentTag);
                        // Keep a progress-first attempt independently of the next active child.
                        DataTableSetInt(true, parentKey + "PendingChild", tag);
                        DataTableSetFixed(true, parentKey + "PendingTime", GameGetMissionTime());
                    }
                    DataTableSetBool(true, key + "Progress", true);
                    DataTableSetFixed(true, key + "ProgressTime", GameGetMissionTime());
                    OPP_BuildPublish(tag);
                }
                
                void OPP_BuildParentOrderSignal (unit parent, string ability) {
                    string key;
                    string childKey;
                    int tag;
                    int childTag;
                    int pendingTag;
                    if (parent == null) { return; }
                    tag = UnitGetTag(parent);
                    key = OPP_BuildKey(tag);
                    childTag = DataTableGetInt(true, key + "Child");
                    pendingTag = DataTableGetInt(true, key + "PendingChild");
                    if (pendingTag &gt; 0 &amp;&amp; DataTableGetFixed(true, key + "PendingTime") == GameGetMissionTime() &amp;&amp; !DataTableGetBool(true, OPP_BuildKey(pendingTag) + "Closed")) { childTag = pendingTag; }
                    childKey = OPP_BuildKey(childTag);
                    if (childTag &lt;= 0 || DataTableGetInt(true, childKey + "Parent") != tag || DataTableGetString(true, childKey + "Ability") != ability) { return; }
                    OPP_BuildOrderSignal(childTag);
                }
                
                bool OPP_BuildCancelled (bool testConds, bool runActions) {
                    if (!runActions) { return true; }
                    OPP_BuildProgressSignal(EventUnit(), EventUnitProgressUnit(), EventUnitProgressObjectType());
                    return true;
                }
                
                bool OPP_BuildCancelOrder (bool testConds, bool runActions) {
                    abilcmd command;
                    string ability;
                    int owner;
                    if (!runActions || EventUnit() == null) { return true; }
                    command = OrderGetAbilityCommand(EventUnitOrder());
                    ability = AbilityCommandGetAbility(command);
                    if (ability == "BuildInProgress" &amp;&amp; AbilityCommandGetCommand(command) == c_abilBuildableCmdCancel) {
                        // The child may already be removed. Use its saved metadata and tag.
                        OPP_BuildOrderSignal(UnitGetTag(EventUnit()));
                        return true;
                    }
                    owner = UnitGetOwner(EventUnit());
                    if (AbilityClass(ability) != c_classIdCAbilBuild || AbilityCommandGetCommand(command) != c_abilBuildCmdHalt || owner &lt; 1 || owner &gt;= c_playerAny || CatalogFieldValueGet(c_gameCatalogAbil, ability, "Type", owner) != "AddOn") { return true; }
                    OPP_BuildParentOrderSignal(EventUnit(), ability);
                    return true;
                }
                
                bool OPP_BuildCompleted (bool testConds, bool runActions) {
                    if (!runActions || EventUnitProgressUnit() == null) { return true; }
                    // A later Halt/rejected Cancel must not resurrect a completed attempt.
                    DataTableSetBool(true, OPP_BuildKey(UnitGetTag(EventUnitProgressUnit())) + "Closed", true);
                    return true;
                }
                
                void OPP_Events_Init () {
                    trigger construction;
                    construction = TriggerCreate("OPP_BuildCreated");
                    TriggerAddEventUnitCreated(construction, null, null, null);
                    construction = TriggerCreate("OPP_BuildStarted");
                    TriggerAddEventUnitConstructProgress(construction, null, c_unitProgressStageStart);
                    construction = TriggerCreate("OPP_BuildCancelled");
                    TriggerAddEventUnitConstructProgress(construction, null, c_unitProgressStageCancel);
                    construction = TriggerCreate("OPP_BuildCompleted");
                    TriggerAddEventUnitConstructProgress(construction, null, c_unitProgressStageComplete);
                    construction = TriggerCreate("OPP_BuildCancelOrder");
                    TriggerAddEventUnitOrder(construction, null, null);
                }
                // Physical warp-in instances own publication, for both Warpable Cancel and
                // power lost by explicit Prism closure or destruction of its actual provider.
                // Dynamic records retain active instances independently of history.
                // Provider edges survive their loss until correlation
                // closes at a later game instant; callback-time power queries alone are too late.
                int OPP_WarpSequence = 0;
                int OPP_WarpHead = 0;
                int OPP_WarpRecords = 0;
                int OPP_PowerSequence = 0;
                int OPP_PowerHead = 0;
                int OPP_PowerRecords = 0;
                
                string OPP_WarpKey (int generation) { return "OPPCancelPopups/Warp/" + IntToString(generation) + "/"; }
                string OPP_PowerKey (int generation) { return "OPPCancelPopups/Power/" + IntToString(generation) + "/"; }
                string OPP_WarpIndex (int tag) { return "OPPCancelPopups/WarpTag/" + IntToString(tag); }
                string OPP_PowerIndex (int tag) { return "OPPCancelPopups/PowerTag/" + IntToString(tag); }
                string OPP_WarpEdge (int warp, int source) { return OPP_WarpKey(warp) + "Provider/" + IntToString(source) + "/"; }
                
                bool OPP_PowerBehavior (string behavior) {
                    if (behavior == "" || !CatalogEntryIsValid(c_gameCatalogBehavior, behavior)) { return false; }
                    // Compare verified catalog classes, without inventing a numeric class ID.
                    return CatalogEntryClass(c_gameCatalogBehavior, behavior) == CatalogEntryClass(c_gameCatalogBehavior, "PowerSource");
                }
                
                bool OPP_PowerCapable (unit source) {
                    int i;
                    int count;
                    int owner;
                    string objectType;
                    string behavior;
                    if (source == null || !UnitIsValid(source) || !UnitIsAlive(source)) { return false; }
                    owner = UnitGetOwner(source);
                    objectType = UnitGetType(source);
                    count = CatalogFieldValueCount(c_gameCatalogUnit, objectType, "BehaviorArray", owner);
                    for (i = 0; i &lt; count; i += 1) {
                        behavior = CatalogFieldValueGet(c_gameCatalogUnit, objectType, "BehaviorArray[" + IntToString(i) + "].Link", owner);
                        if (OPP_PowerBehavior(behavior)) { return true; }
                    }
                    return false;
                }
                
                int OPP_PowerRemember (unit source, bool knownBehavior) {
                    int generation;
                    string key;
                    if (source == null || !UnitIsValid(source) || !UnitIsAlive(source)) { return 0; }
                    generation = DataTableGetInt(true, OPP_PowerIndex(UnitGetTag(source)));
                    if (generation &gt; 0) { return generation; }
                    if (!knownBehavior &amp;&amp; !OPP_PowerCapable(source)) { return 0; }
                    OPP_PowerSequence += 1;
                    generation = OPP_PowerSequence;
                    key = OPP_PowerKey(generation);
                    DataTableSetUnit(true, key + "Unit", source);
                    DataTableSetInt(true, key + "Tag", UnitGetTag(source));
                    DataTableSetString(true, key + "Type", UnitGetType(source));
                    DataTableSetInt(true, key + "Next", OPP_PowerHead);
                    DataTableSetFixed(true, key + "Touched", GameGetMissionTime());
                    DataTableSetInt(true, OPP_PowerIndex(UnitGetTag(source)), generation);
                    OPP_PowerHead = generation;
                    OPP_PowerRecords += 1;
                    if (OPP_PowerRecords &gt; DataTableGetInt(true, "OPPCancelPopups/PowerPeakRecords")) { DataTableSetInt(true, "OPPCancelPopups/PowerPeakRecords", OPP_PowerRecords); }
                    return generation;
                }
                
                void OPP_WarpRefreshPair (int warp, int sourceGeneration) {
                    int owner;
                    string sourceKey;
                    string key;
                    string edge;
                    unit source;
                    bool supplied;
                    bool previous;
                    bool valid;
                    if (sourceGeneration &lt;= 0 || warp &lt;= 0) { return; }
                    sourceKey = OPP_PowerKey(sourceGeneration);
                    source = DataTableGetUnit(true, sourceKey + "Unit");
                    valid = source != null &amp;&amp; UnitIsValid(source) &amp;&amp; UnitIsAlive(source);
                    key = OPP_WarpKey(warp);
                    edge = OPP_WarpEdge(warp, sourceGeneration);
                    owner = DataTableGetInt(true, key + "Owner");
                    supplied = false;
                    // Registry membership proves this is a provider-capable unit. Never
                    // call the native on a dead/removed nonnull handle (runtime v71/v72).
                    if (valid &amp;&amp; !DataTableGetBool(true, key + "Cancelled")) { supplied = PowerIsProvidedBy(owner, DataTableGetPoint(true, key + "Point"), "PowerSource", source, 1); }
                    previous = DataTableGetBool(true, edge + "Current");
                    if (supplied &amp;&amp; !DataTableGetBool(true, edge + "Known")) {
                        DataTableSetBool(true, edge + "Known", true);
                        DataTableSetInt(true, edge + "SourceTag", DataTableGetInt(true, sourceKey + "Tag"));
                        DataTableSetInt(true, edge + "Next", DataTableGetInt(true, key + "Providers"));
                        DataTableSetInt(true, key + "Providers", sourceGeneration);
                    }
                    if (previous &amp;&amp; !supplied) {
                        DataTableSetBool(true, edge + "Lost", true);
                        DataTableSetFixed(true, edge + "LostTime", GameGetMissionTime());
                    }
                    if (supplied) { DataTableSetBool(true, edge + "Lost", false); }
                    if (supplied || DataTableGetBool(true, edge + "Known")) { DataTableSetBool(true, edge + "Current", supplied); }
                    if (DataTableGetBool(true, edge + "Lost")) {
                        // Only the real Unit Died callback proves destruction. An invalid
                        // handle or UnitRemove can remove power without a death event.
                        if (DataTableGetBool(true, sourceKey + "Death")) {
                            DataTableSetBool(true, edge + "Death", true);
                            DataTableSetFixed(true, edge + "DeathTime", DataTableGetFixed(true, sourceKey + "DeathTime"));
                        }
                        if (DataTableGetBool(true, sourceKey + "Order") &amp;&amp; DataTableGetFixed(true, sourceKey + "OrderTime") == DataTableGetFixed(true, edge + "LostTime")) {
                            DataTableSetBool(true, edge + "CloseOrder", true);
                            DataTableSetFixed(true, edge + "CloseOrderTime", DataTableGetFixed(true, sourceKey + "OrderTime"));
                        }
                        if (DataTableGetBool(true, sourceKey + "Execute") &amp;&amp; DataTableGetFixed(true, sourceKey + "ExecuteTime") == DataTableGetFixed(true, edge + "LostTime")) {
                            DataTableSetBool(true, edge + "CloseExecute", true);
                            DataTableSetFixed(true, edge + "CloseExecuteTime", DataTableGetFixed(true, sourceKey + "ExecuteTime"));
                        }
                    }
                }
                
