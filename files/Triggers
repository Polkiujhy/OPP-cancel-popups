<?xml version='1.0' encoding='utf-8'?>
<TriggerData>
    <Library Id="C0DEC0DE">
        <Root>
            <Item Type="CustomScript" Library="C0DEC0DE" Id="00000001" />
            <Item Type="Trigger" Library="C0DEC0DE" Id="00000002" />
