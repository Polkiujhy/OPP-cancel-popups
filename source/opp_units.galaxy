// Ability Cancel also fires for waiting queue entries; progress Cancel only
// fires for the running entry (SC2 runtime probe v55). Pair either source with
// an explicit queue/warp Cancel order in the same synchronous game tick.
// The two source counts overlap: publish their maximum, never their sum.
int[128] OPP_UnitOrderTag;
int[128] OPP_UnitOrderTick;
int OPP_UnitOrderNext = 0;
int[256] OPP_UnitPendingTag;
int[256] OPP_UnitPendingTick;
int[256] OPP_UnitPendingOwner;
string[256] OPP_UnitPendingType;
int[256] OPP_UnitPendingKind;
int[256] OPP_UnitPendingProgress;
int[256] OPP_UnitPendingAbility;
int[256] OPP_UnitPendingSent;
int OPP_UnitPendingNext = 0;

void OPP_UnitPublish (int slot) {
    string objectType;
    int owner;
    int count;
    text name;
    string icon;
    count = OPP_UnitPendingAbility[slot];
    if (OPP_UnitPendingProgress[slot] > count) { count = OPP_UnitPendingProgress[slot]; }
    objectType = OPP_UnitPendingType[slot];
    owner = OPP_UnitPendingOwner[slot];
    if (OPP_UnitPendingKind[slot] == OPP_KIND_RESEARCH) {
        name = StringExternal(CatalogFieldValueGet(c_gameCatalogUpgrade, objectType, "Name", owner));
        icon = CatalogFieldValueGet(c_gameCatalogUpgrade, objectType, "Icon", owner);
    }
    else {
        name = UnitTypeGetName(objectType);
        icon = CatalogFieldValueGet(c_gameCatalogActor, objectType, "UnitIcon", owner);
    }
    while (OPP_UnitPendingSent[slot] < count) {
        OPP_UnitPendingSent[slot] += 1;
        OPP_UI_PushTyped(owner, name, icon, OPP_UnitPendingKind[slot], objectType);
        if (OPP_UnitPendingKind[slot] == OPP_KIND_RESEARCH) {
            DataTableSetInt(true, "OPPCancelPopups/ResearchOwn", DataTableGetInt(true, "OPPCancelPopups/ResearchOwn") + 1);
        }
        else {
            DataTableSetInt(true, "OPPCancelPopups/UnitCancels", DataTableGetInt(true, "OPPCancelPopups/UnitCancels") + 1);
        }
    }
}

void OPP_UnitSignal (unit facility, string objectType, int kind, bool progress) {
    int owner;
    int tag;
    int tick;
    int slot;
    int i;
    if (facility == null || objectType == "") { return; }
    owner = UnitGetOwner(facility);
    tag = UnitGetTag(facility);
    if (tag <= 0 || owner < 1 || owner >= c_playerAny) { return; }
    tick = CurrentSynchronousGameTimeGet();
    slot = -1;
    for (i = 0; i < 256; i += 1) {
        if (OPP_UnitPendingTag[i] == tag && OPP_UnitPendingTick[i] == tick && OPP_UnitPendingOwner[i] == owner && OPP_UnitPendingKind[i] == kind && OPP_UnitPendingType[i] == objectType) { slot = i; }
    }
    if (slot < 0) {
        slot = OPP_UnitPendingNext;
        OPP_UnitPendingNext = (slot + 1) % 256;
        OPP_UnitPendingTag[slot] = tag;
        OPP_UnitPendingTick[slot] = tick;
        OPP_UnitPendingOwner[slot] = owner;
        OPP_UnitPendingType[slot] = objectType;
        OPP_UnitPendingKind[slot] = kind;
        OPP_UnitPendingAbility[slot] = 0;
        OPP_UnitPendingProgress[slot] = 0;
        OPP_UnitPendingSent[slot] = 0;
    }
    if (progress) { OPP_UnitPendingProgress[slot] += 1; }
    else { OPP_UnitPendingAbility[slot] += 1; }
    for (i = 0; i < 128; i += 1) {
        if (OPP_UnitOrderTag[i] == tag && OPP_UnitOrderTick[i] == tick) {
            OPP_UnitPublish(slot);
            return;
        }
    }
}

bool OPP_UnitProductionCancelled (bool testConds, bool runActions) {
    if (!runActions || EventUnit() == null || !UnitIsAlive(EventUnit())) { return true; }
    OPP_UnitSignal(EventUnit(), EventUnitProgressObjectType(), OPP_KIND_UNIT, true);
    return true;
}

bool OPP_ProductionAbilityCancelled (bool testConds, bool runActions) {
    unit facility;
    string ability;
    string field;
    string objectType;
    int abilityClass;
    int owner;
    int count;
    int item;
    if (!runActions || EventUnit() == null) { return true; }
    facility = EventUnit();
    owner = UnitGetOwner(facility);
    if (owner < 1 || owner >= c_playerAny) { return true; }
    ability = AbilityCommandGetAbility(EventUnitAbility());
    abilityClass = AbilityClass(ability);
    field = "InfoArray[" + IntToString(AbilityCommandGetCommand(EventUnitAbility())) + "]";
    if (abilityClass == c_classIdCAbilResearch) {
        if (!UnitIsAlive(facility) || !DataTableGetBool(true, "OPPCancelPopups/ResearchAdapter")) { return true; }
        objectType = CatalogFieldValueGet(c_gameCatalogAbil, ability, field + ".Upgrade", owner);
        OPP_UnitSignal(facility, objectType, OPP_KIND_RESEARCH, false);
    }
    else if (abilityClass == c_classIdCAbilTrain || abilityClass == c_classIdCAbilArmMagazine || abilityClass == c_classIdCAbilWarpTrain) {
        // LarvaTrain deliberately destroys the egg on a legitimate Cancel.
        // Other dead producers must not contribute their lost queue entries.
        if (!UnitIsAlive(facility) && (abilityClass != c_classIdCAbilTrain || CatalogFieldValueGet(c_gameCatalogAbil, ability, "Flags[KillOnCancel]", owner) != "1")) { return true; }
        if (abilityClass == c_classIdCAbilTrain) {
            count = CatalogFieldValueCount(c_gameCatalogAbil, ability, field + ".Unit", owner);
            for (item = 0; item < count; item += 1) {
                objectType = CatalogFieldValueGet(c_gameCatalogAbil, ability, field + ".Unit[" + IntToString(item) + "]", owner);
                OPP_UnitSignal(facility, objectType, OPP_KIND_UNIT, false);
            }
        }
        else {
            objectType = CatalogFieldValueGet(c_gameCatalogAbil, ability, field + ".Unit", owner);
            OPP_UnitSignal(facility, objectType, OPP_KIND_UNIT, false);
        }
    }
    return true;
}

bool OPP_UnitProductionCancelOrder (bool testConds, bool runActions) {
    abilcmd command;
    int abilityClass;
    int index;
    int tag;
    int tick;
    int i;
    if (!runActions || EventUnit() == null) { return true; }
    command = OrderGetAbilityCommand(EventUnitOrder());
    abilityClass = AbilityClass(AbilityCommandGetAbility(command));
    index = AbilityCommandGetCommand(command);
    if (!((abilityClass == c_classIdCAbilQueue && (index == c_abilQueueCmdCancelLast || index == c_abilQueueCmdCancelSlot)) || (abilityClass == c_classIdCAbilWarpable && index == c_abilWarpableCmdCancel))) { return true; }
    tag = UnitGetTag(EventUnit());
    tick = CurrentSynchronousGameTimeGet();
    OPP_UnitOrderTag[OPP_UnitOrderNext] = tag;
    OPP_UnitOrderTick[OPP_UnitOrderNext] = tick;
    OPP_UnitOrderNext = (OPP_UnitOrderNext + 1) % 128;
    for (i = 0; i < 256; i += 1) {
        if (OPP_UnitPendingTag[i] == tag && OPP_UnitPendingTick[i] == tick) {
            OPP_UnitPublish(i);
        }
    }
    return true;
}

void OPP_Units_Init () {
    trigger progress;
    trigger cancelOrder;
    trigger abilityCancel;
    progress = TriggerCreate("OPP_UnitProductionCancelled");
    TriggerAddEventUnitTrainProgress(progress, null, c_unitProgressStageCancel);
    TriggerAddEventUnitArmMagazineProgress(progress, null, c_unitProgressStageCancel);
    abilityCancel = TriggerCreate("OPP_ProductionAbilityCancelled");
    TriggerAddEventUnitAbility(abilityCancel, null, null, c_unitAbilStageCancel, false);
    cancelOrder = TriggerCreate("OPP_UnitProductionCancelOrder");
    TriggerAddEventUnitOrder(cancelOrder, null, null);
}
