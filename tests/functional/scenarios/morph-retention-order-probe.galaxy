// Short native-order prerequisite probe; not the full 301-link acceptance.
// morph-retention-state.galaxy is prepended by the stager without modification.
include "LibC0DEC0DE_h"
bool OPP_Test_Run (bool testConds, bool runActions) {
    bank output;
    unit held;
    if (!runActions) { return true; }
    output = BankLoad("OPPBuildingCancelTest", 1);
    BankValueSetFromString(output, "Probe", "Fixture", "morph-retention-order-probe");
    BankValueSetFromFlag(output, "Finished", "Done", false);
    UnitCreate(1, "CommandCenter", 0, 1, Point(25.0, 25.0), 270.0);
    UnitCreate(1, "Nexus", 0, 2, Point(105.0, 105.0), 270.0);
    TechTreeRequirementsEnable(1, false);
    TechTreeRestrictionsEnable(1, false);
    PlayerSetRace(1, "Zerg");
    PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSetTo, 100000);
    PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSetTo, 100000);
    PlayerModifyPropertyInt(1, c_playerPropSuppliesMade, c_playerPropOperSetTo, 200);
    CreepModify(Point(42.0, 65.0), 18.0, true, true);
    Wait(8.0, c_timeGame);
    UnitCreate(1, "Hatchery", c_unitCreateIgnorePlacement, 1, Point(42.0, 65.0), 270.0);
    held = UnitLastCreated();
    BankValueSetFromString(output, "RetentionHeld", "Evidence", "real-engine-attempt");
    BankValueSetFromFlag(output, "RetentionHeld", "Created", held != null && UnitIsValid(held));
    OPP_MH_Lengthen(output, "RetentionHeld");
    OPP_MH_StartTrace(output, held, "UpgradeToLair", "RetentionHeld");
    BankValueSetFromFlag(output, "RetentionHeld", "StartAccepted", UnitIssueOrder(held, Order(AbilityCommand("UpgradeToLair", c_abilMorphCmdExecute)), c_orderQueueReplace));
    Wait(0.125, c_timeGame);
    OPP_MH_State(output, "RetentionHeld/StartState", held, "UpgradeToLair");
    Wait(1.0, c_timeGame);
    OPP_MH_State(output, "RetentionHeld/BeforeCancelState", held, "UpgradeToLair");
    BankValueSetFromInt(output, "RetentionHeld", "BeforeMorphs", DataTableGetInt(true, "OPPCancelPopups/MorphCancels"));
    BankValueSetFromFlag(output, "RetentionHeld", "CancelAccepted", UnitIssueOrder(held, Order(AbilityCommand("UpgradeToLair", c_abilMorphCmdCancel)), c_orderQueueReplace));
    Wait(0.1875, c_timeGame);
    OPP_MH_State(output, "RetentionHeld/AfterCancelState", held, "UpgradeToLair");
    BankValueSetFromInt(output, "RetentionHeld", "AfterMorphs", DataTableGetInt(true, "OPPCancelPopups/MorphCancels"));
    OPP_MH_CloseTrace();
    BankValueSetFromFixed(output, "Finished", "Time", GameGetMissionTime());
    BankValueSetFromFlag(output, "Finished", "Done", true);
    BankSave(output);
    Wait(2.0, c_timeGame);
    GameOver(1, c_gameOverDefeat, true, false);
    return true;
}
