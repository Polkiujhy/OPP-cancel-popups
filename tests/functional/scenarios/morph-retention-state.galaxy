// Map-only native instrumentation shared by the short probe and full fixture.
bank OPP_MH_Bank;
unit OPP_MH_Subject;
string OPP_MH_Ability;
string OPP_MH_Case;
bool OPP_MH_Tracking = false;
int OPP_MH_Events = 0;

void OPP_MH_Lengthen (bank output, string section) {
    BankValueSetFromFlag(output, section, "Lengthened", CatalogFieldValueSet(c_gameCatalogAbil, "UpgradeToLair", "InfoArray[0].SectionArray[Abils].DurationArray[Delay]", 1, "600"));
    BankValueSetFromFlag(output, section, "LengthenedActor", CatalogFieldValueSet(c_gameCatalogAbil, "UpgradeToLair", "InfoArray[0].SectionArray[Actor].DurationArray[Duration]", 1, "600"));
    BankValueSetFromFlag(output, section, "LengthenedStats", CatalogFieldValueSet(c_gameCatalogAbil, "UpgradeToLair", "InfoArray[0].SectionArray[Stats].DurationArray[Delay]", 1, "600"));
}

void OPP_MH_State (bank output, string section, unit subject, string ability) {
    int count;
    order current;
    abilcmd command;
    BankValueSetFromFixed(output, section, "Time", GameGetMissionTime());
    BankValueSetFromFlag(output, section, "Exists", subject != null && UnitIsValid(subject));
    BankValueSetFromFlag(output, section, "Alive", subject != null && UnitIsValid(subject) && UnitIsAlive(subject));
    BankValueSetFromFlag(output, section, "HasMorphOrder", false);
    BankValueSetFromInt(output, section, "OrderCount", 0);
    BankValueSetFromString(output, section, "Order0Ability", "");
    BankValueSetFromInt(output, section, "Order0Command", -1);
    if (subject != null && UnitIsValid(subject)) {
        BankValueSetFromInt(output, section, "Tag", UnitGetTag(subject));
        BankValueSetFromInt(output, section, "Owner", UnitGetOwner(subject));
        BankValueSetFromString(output, section, "Type", UnitGetType(subject));
        if (UnitIsAlive(subject)) {
            // A command's Executing bit is diagnostic, not process liveness.
            BankValueSetFromFlag(output, section, "CommandExecuting", UnitCheckAbilCmdState(subject, AbilityCommand(ability, c_abilMorphCmdExecute), c_cmdStateExecuting));
            BankValueSetFromFlag(output, section, "UnderConstruction", UnitTestState(subject, c_unitStateUnderConstruction));
            BankValueSetFromFlag(output, section, "HasMorphOrder", UnitOrderHasAbil(subject, ability));
            count = UnitOrderCount(subject);
            BankValueSetFromInt(output, section, "OrderCount", count);
            if (count > 0) {
                current = UnitOrder(subject, 0);
                if (current != null) {
                    command = OrderGetAbilityCommand(current);
                    if (command != null) {
                        BankValueSetFromString(output, section, "Order0Ability", AbilityCommandGetAbility(command));
                        BankValueSetFromInt(output, section, "Order0Command", AbilityCommandGetCommand(command));
                    }
                }
            }
        }
    }
    BankSave(output);
}

void OPP_MH_Record (string label, int stage, int command) {
    string section;
    OPP_MH_Events += 1;
    section = "HeldEvent" + IntToString(OPP_MH_Events);
    BankValueSetFromString(OPP_MH_Bank, section, "Case", OPP_MH_Case);
    BankValueSetFromString(OPP_MH_Bank, section, "Label", label);
    BankValueSetFromString(OPP_MH_Bank, section, "Ability", OPP_MH_Ability);
    BankValueSetFromInt(OPP_MH_Bank, section, "Command", command);
    BankValueSetFromInt(OPP_MH_Bank, section, "Stage", stage);
    BankValueSetFromInt(OPP_MH_Bank, section, "Tag", UnitGetTag(EventUnit()));
    BankValueSetFromInt(OPP_MH_Bank, section, "Owner", UnitGetOwner(EventUnit()));
    BankValueSetFromFlag(OPP_MH_Bank, section, "Alive", UnitIsAlive(EventUnit()));
    BankValueSetFromFixed(OPP_MH_Bank, section, "Time", GameGetMissionTime());
    BankValueSetFromInt(OPP_MH_Bank, "HeldTrace", "Events", OPP_MH_Events);
    BankSave(OPP_MH_Bank);
}

bool OPP_MH_AbilityEvent (bool testConds, bool runActions) {
    abilcmd command;
    int stage;
    if (!runActions || !OPP_MH_Tracking || EventUnit() != OPP_MH_Subject) { return true; }
    command = EventUnitAbility();
    if (AbilityCommandGetAbility(command) != OPP_MH_Ability || AbilityCommandGetCommand(command) != c_abilMorphCmdExecute) { return true; }
    stage = EventUnitAbilityStage();
    if (stage == c_unitAbilStageExecute || stage == c_unitAbilStageCancel || stage == c_unitAbilStageComplete || stage == c_unitAbilStagePreempt) {
        OPP_MH_Record("Ability", stage, c_abilMorphCmdExecute);
    }
    return true;
}

bool OPP_MH_OrderEvent (bool testConds, bool runActions) {
    abilcmd command;
    if (!runActions || !OPP_MH_Tracking || EventUnit() != OPP_MH_Subject) { return true; }
    command = OrderGetAbilityCommand(EventUnitOrder());
    if (AbilityCommandGetAbility(command) == OPP_MH_Ability && AbilityCommandGetCommand(command) == c_abilMorphCmdCancel) {
        OPP_MH_Record("Order", 0, c_abilMorphCmdCancel);
    }
    return true;
}

void OPP_MH_StartTrace (bank output, unit subject, string ability, string label) {
    trigger observer;
    OPP_MH_Bank = output;
    OPP_MH_Subject = subject;
    OPP_MH_Ability = ability;
    OPP_MH_Case = label;
    OPP_MH_Events = 0;
    OPP_MH_Tracking = true;
    BankValueSetFromInt(output, "HeldTrace", "Events", 0);
    BankValueSetFromFlag(output, "HeldTrace", "Closed", false);
    observer = TriggerCreate("OPP_MH_AbilityEvent");
    TriggerAddEventUnitAbility(observer, null, null, c_unitAbilStageAll, false);
    observer = TriggerCreate("OPP_MH_OrderEvent");
    TriggerAddEventUnitOrder(observer, null, null);
    BankSave(output);
}

void OPP_MH_CloseTrace () {
    OPP_MH_Tracking = false;
    BankValueSetFromFlag(OPP_MH_Bank, "HeldTrace", "Closed", true);
    BankSave(OPP_MH_Bank);
}
