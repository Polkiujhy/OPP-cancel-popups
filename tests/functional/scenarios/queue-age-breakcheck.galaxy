// Focused runtime mutation check; synthetic pushes exercise only queue grouping.
include "LibC0DEC0DE_h"
void OPP_QueueFixture_Push (int owner, string name, int kind, string key);
void OPP_QueueFixture_Reset ();
void OPP_QueueFixture_Snapshot (bank output, string section, bool details);
bank OPP_Test_Bank;
void OPP_Age_Block () {
    int i;
    for (i = 0; i < 3; i += 1) { OPP_QueueFixture_Push(1, "Block" + IntToString(i), 0, "Block" + IntToString(i)); }
}
bool OPP_Test_Run (bool testConds, bool runActions) {
    if (!runActions) { return true; }
    OPP_Test_Bank = BankLoad("OPPBuildingCancelTest", 1);
    BankValueSetFromString(OPP_Test_Bank, "Probe", "Fixture", "queue-age-breakcheck");
    UnitCreate(1, "CommandCenter", 0, 1, Point(25.0, 25.0), 270.0);
    UnitCreate(1, "Nexus", 0, 2, Point(105.0, 105.0), 270.0);
    Wait(8.0, c_timeGame);
    OPP_QueueFixture_Reset();
    OPP_Age_Block();
    OPP_QueueFixture_Push(1, "Oracle", 2, "Oracle");
    OPP_QueueFixture_Push(1, "Phoenix", 2, "Phoenix");
    OPP_QueueFixture_Push(1, "Oracle", 2, "Oracle");
    OPP_QueueFixture_Snapshot(OPP_Test_Bank, "Age/Initial", true);
    Wait(4.0, c_timeGame); OPP_Age_Block();
    Wait(4.0, c_timeGame); OPP_Age_Block();
    Wait(2.5, c_timeGame);
    OPP_QueueFixture_Push(1, "Oracle", 2, "Oracle");
    OPP_QueueFixture_Snapshot(OPP_Test_Bank, "Age/Late", true);
    Wait(2.75, c_timeGame);
    OPP_QueueFixture_Snapshot(OPP_Test_Bank, "Age/Shown", true);
    Wait(4.5, c_timeGame);
    OPP_QueueFixture_Snapshot(OPP_Test_Bank, "Age/NearExpiry", true);
    Wait(0.5, c_timeGame);
    OPP_QueueFixture_Snapshot(OPP_Test_Bank, "Age/Expired", true);
    BankValueSetFromFlag(OPP_Test_Bank, "Finished", "Done", true);
    BankSave(OPP_Test_Bank);
    Wait(2.0, c_timeGame);
    GameOver(1, c_gameOverDefeat, true, false);
    return true;
}
