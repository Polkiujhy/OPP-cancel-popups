// Isolated queue-cancellation regression fixture; never packaged in the mod.
include "LibGHLo_h"
bank OPP_Test_Bank;
int OPP_Test_Sequence = 0;

void OPP_Test_Record (string label, unit facility, abilcmd command, int stage, string objectType) {
    string section;
    string key;
    int slot;
    int item;
    int count;
    int control;
    OPP_Test_Sequence += 1;
    section = "Event" + IntToString(OPP_Test_Sequence);
    BankValueSetFromString(OPP_Test_Bank, section, "Label", label);
    BankValueSetFromFixed(OPP_Test_Bank, section, "Time", GameGetMissionTime());
    BankValueSetFromString(OPP_Test_Bank, section, "Facility", UnitGetType(facility));
    BankValueSetFromInt(OPP_Test_Bank, section, "Tag", UnitGetTag(facility));
    BankValueSetFromFlag(OPP_Test_Bank, section, "Alive", UnitIsAlive(facility));
    BankValueSetFromString(OPP_Test_Bank, section, "Ability", AbilityCommandGetAbility(command));
    BankValueSetFromInt(OPP_Test_Bank, section, "Command", AbilityCommandGetCommand(command));
    BankValueSetFromInt(OPP_Test_Bank, section, "Stage", stage);
    BankValueSetFromString(OPP_Test_Bank, section, "Object", objectType);
    if (facility != null && UnitIsAlive(facility)) {
        BankValueSetFromInt(OPP_Test_Bank, section, "Used", UnitQueueGetProperty(facility, c_unitQueuePropertyUsed));
        BankValueSetFromInt(OPP_Test_Bank, section, "Count", UnitQueueGetProperty(facility, c_unitQueuePropertyCount));
        for (slot = 1; slot <= 6; slot += 1) {
            key = "Slot" + IntToString(slot);
            count = UnitQueueItemCount(facility, slot);
            BankValueSetFromInt(OPP_Test_Bank, section, key + "Count", count);
            if (count > 0) {
                BankValueSetFromFlag(OPP_Test_Bank, section, key + "Train", UnitQueueItemTypeCheck(facility, slot, c_unitProgressTypeTrain));
                BankValueSetFromFlag(OPP_Test_Bank, section, key + "Research", UnitQueueItemTypeCheck(facility, slot, c_unitProgressTypeResearch));
                for (item = 1; item <= count; item += 1) {
                    BankValueSetFromString(OPP_Test_Bank, section, key + "Item" + IntToString(item), UnitQueueItemGet(facility, slot, item));
                }
            }
        }
    }
    BankValueSetFromInt(OPP_Test_Bank, section, "UnitCancels", DataTableGetInt(true, "OPPCancelPopups/UnitCancels"));
    BankValueSetFromInt(OPP_Test_Bank, section, "ResearchOwn", DataTableGetInt(true, "OPPCancelPopups/ResearchOwn"));
    BankValueSetFromInt(OPP_Test_Bank, section, "InitializationCount", DataTableGetInt(true, "OPPCancelPopups/InitializationCount"));
    for (slot = 0; slot < 3; slot += 1) {
        key = "Row" + IntToString(slot);
        control = DataTableGetInt(true, "OPPCancelPopups/Panel" + IntToString(slot));
        BankValueSetFromFlag(OPP_Test_Bank, section, key + "ObserverVisible", DialogControlIsVisible(control, 14));
        BankValueSetFromFlag(OPP_Test_Bank, section, key + "Player1Visible", DialogControlIsVisible(control, 1));
        BankValueSetFromFlag(OPP_Test_Bank, section, key + "Player2Visible", DialogControlIsVisible(control, 2));
        if (DialogControlIsVisible(control, 14)) {
            control = DataTableGetInt(true, "OPPCancelPopups/Name" + IntToString(slot));
            BankValueSetFromText(OPP_Test_Bank, section, key + "Name", DialogControlGetPropertyAsText(control, c_triggerControlPropertyText, 14));
            control = DataTableGetInt(true, "OPPCancelPopups/Status" + IntToString(slot));
            BankValueSetFromText(OPP_Test_Bank, section, key + "Status", DialogControlGetPropertyAsText(control, c_triggerControlPropertyText, 14));
        }
    }
    BankSave(OPP_Test_Bank);
}

bool OPP_Test_Order (bool testConds, bool runActions) {
    if (!runActions) { return true; }
    OPP_Test_Record("Order", EventUnit(), OrderGetAbilityCommand(EventUnitOrder()), 0, "");
    return true;
}
bool OPP_Test_Ability (bool testConds, bool runActions) {
    if (!runActions) { return true; }
    OPP_Test_Record("Ability", EventUnit(), EventUnitAbility(), EventUnitAbilityStage(), "");
    return true;
}
bool OPP_Test_TrainStart (bool testConds, bool runActions) {
    if (!runActions) { return true; }
    OPP_Test_Record("TrainStart", EventUnit(), null, 0, EventUnitProgressObjectType());
    return true;
}
bool OPP_Test_TrainCancel (bool testConds, bool runActions) {
    if (!runActions) { return true; }
    OPP_Test_Record("TrainCancel", EventUnit(), null, 1, EventUnitProgressObjectType());
    return true;
}
bool OPP_Test_TrainComplete (bool testConds, bool runActions) {
    if (!runActions) { return true; }
    OPP_Test_Record("TrainComplete", EventUnit(), null, 2, EventUnitProgressObjectType());
    return true;
}
bool OPP_Test_ResearchStart (bool testConds, bool runActions) {
    if (!runActions) { return true; }
    OPP_Test_Record("ResearchStart", EventUnit(), null, 0, EventUnitProgressObjectType());
    return true;
}
bool OPP_Test_ResearchCancel (bool testConds, bool runActions) {
    if (!runActions) { return true; }
    OPP_Test_Record("ResearchCancel", EventUnit(), null, 1, EventUnitProgressObjectType());
    return true;
}

bool OPP_Test_Run (bool testConds, bool runActions) {
    unit center;
    unit research;
    unit completed;
    trigger probe;
    int i;
    bool accepted;
    if (!runActions) { return true; }
    OPP_Test_Bank = BankLoad("OPPBuildingCancelTest", 1);
    probe = TriggerCreate("OPP_Test_Order");
    TriggerAddEventUnitOrder(probe, null, null);
    probe = TriggerCreate("OPP_Test_Ability");
    TriggerAddEventUnitAbility(probe, null, null, c_unitAbilStageAll, false);
    probe = TriggerCreate("OPP_Test_TrainStart");
    TriggerAddEventUnitTrainProgress(probe, null, c_unitProgressStageStart);
    probe = TriggerCreate("OPP_Test_TrainCancel");
    TriggerAddEventUnitTrainProgress(probe, null, c_unitProgressStageCancel);
    probe = TriggerCreate("OPP_Test_TrainComplete");
    TriggerAddEventUnitTrainProgress(probe, null, c_unitProgressStageComplete);
    probe = TriggerCreate("OPP_Test_ResearchStart");
    TriggerAddEventUnitResearchProgress(probe, null, c_unitProgressStageStart);
    probe = TriggerCreate("OPP_Test_ResearchCancel");
    TriggerAddEventUnitResearchProgress(probe, null, c_unitProgressStageCancel);
    UnitCreate(1, "CommandCenter", 0, 1, Point(25.0, 25.0), 270.0);
    center = UnitLastCreated();
    UnitCreate(1, "Nexus", 0, 2, Point(105.0, 105.0), 270.0);
    UnitCreate(1, "EngineeringBay", 0, 1, Point(40.0, 40.0), 270.0);
    research = UnitLastCreated();
    PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSetTo, 5000);
    PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSetTo, 5000);
    Wait(8.0, c_timeGame);
    for (i = 0; i < 5; i += 1) {
        accepted = UnitIssueOrder(center, Order(AbilityCommand("CommandCenterTrain", c_abilTrainCmdTrain1)), c_orderQueueAddToEnd);
        BankValueSetFromFlag(OPP_Test_Bank, "Orders", "Train" + IntToString(i), accepted);
    }
    Wait(1.0, c_timeGame);
    OPP_Test_Record("FiveQueued", center, null, 0, "");
    for (i = 0; i < 5; i += 1) {
        accepted = UnitIssueOrder(center, Order(AbilityCommand("que5CancelToSelection", c_abilQueueCmdCancelLast)), c_orderQueueReplace);
        BankValueSetFromFlag(OPP_Test_Bank, "Orders", "CancelTrain" + IntToString(i), accepted);
        if (i >= 2) { Wait(0.25, c_timeGame); }
        OPP_Test_Record("AfterTrainCancel" + IntToString(i), center, null, 0, "");
    }
    Wait(6.0, c_timeGame);
    accepted = UnitIssueOrder(research, Order(AbilityCommand("EngineeringBayResearch", c_abilResearchCmdResearch3)), c_orderQueueAddToEnd);
    BankValueSetFromFlag(OPP_Test_Bank, "Orders", "Research0", accepted);
    accepted = UnitIssueOrder(research, Order(AbilityCommand("EngineeringBayResearch", c_abilResearchCmdResearch7)), c_orderQueueAddToEnd);
    BankValueSetFromFlag(OPP_Test_Bank, "Orders", "Research1", accepted);
    accepted = UnitIssueOrder(research, Order(AbilityCommand("EngineeringBayResearch", c_abilResearchCmdResearch2)), c_orderQueueAddToEnd);
    BankValueSetFromFlag(OPP_Test_Bank, "Orders", "Research2", accepted);
    Wait(1.0, c_timeGame);
    OPP_Test_Record("ThreeUpgradesQueued", research, null, 0, "");
    for (i = 0; i < 3; i += 1) {
        accepted = UnitIssueOrder(research, Order(AbilityCommand("que5", c_abilQueueCmdCancelLast)), c_orderQueueReplace);
        BankValueSetFromFlag(OPP_Test_Bank, "Orders", "CancelResearch" + IntToString(i), accepted);
        Wait(0.25, c_timeGame);
        OPP_Test_Record("AfterResearchCancel" + IntToString(i), research, null, 0, "");
    }
    Wait(6.0, c_timeGame);
    UnitIssueOrder(center, Order(AbilityCommand("que5CancelToSelection", c_abilQueueCmdCancelLast)), c_orderQueueReplace);
    UnitIssueOrder(research, Order(AbilityCommand("que5", c_abilQueueCmdCancelLast)), c_orderQueueReplace);
    Wait(0.25, c_timeGame);
    OPP_Test_Record("EmptyCancel", center, null, 0, "");
    for (i = 0; i < 3; i += 1) {
        UnitIssueOrder(center, Order(AbilityCommand("CommandCenterTrain", c_abilTrainCmdTrain1)), c_orderQueueAddToEnd);
    }
    UnitIssueOrder(research, Order(AbilityCommand("EngineeringBayResearch", c_abilResearchCmdResearch3)), c_orderQueueAddToEnd);
    UnitIssueOrder(research, Order(AbilityCommand("EngineeringBayResearch", c_abilResearchCmdResearch7)), c_orderQueueAddToEnd);
    Wait(1.0, c_timeGame);
    UnitKill(center);
    UnitKill(research);
    Wait(0.25, c_timeGame);
    OPP_Test_Record("Destroyed", null, null, 0, "");
    UnitCreate(1, "CommandCenter", 0, 1, Point(60.0, 60.0), 270.0);
    completed = UnitLastCreated();
    UnitIssueOrder(completed, Order(AbilityCommand("CommandCenterTrain", c_abilTrainCmdTrain1)), c_orderQueueAddToEnd);
    Wait(0.5, c_timeGame);
    UnitSetProgressComplete(completed, 1, 95);
    Wait(2.0, c_timeGame);
    OPP_Test_Record("Completed", completed, null, 0, "");
    Wait(2.0, c_timeGame);
    GameOver(1, c_gameOverDefeat, true, false);
    return true;
}
